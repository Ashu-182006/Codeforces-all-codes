import sys
def solve():
    n=sys.stdin.read().split()
    if not n:
        return
    i=0
    a=int(n[i])
    i+=1
    b=[int(x) for x in n[i:i+a]]
    i+=a
    k=0
    for i in range(a):
        if i%2==0:
            if b[i]<0:
                k+=1
        else:
            if b[i] > 0:
                k+=1
    l=a-k
    sys.stdout.write(str(min(k, l))+"\n")
if __name__ == "__main__":
    solve()
