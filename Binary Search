import sys
 
def solve():
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    iterator = iter(input_data)
    n = int(next(iterator))
    q = int(next(iterator))
    c = set(int(next(iterator)) for _ in range(n))
    output = []
    for _ in range(q):
        x = int(next(iterator))
        if x in c:
            output.append("found")
        else:
            output.append("not found")
    sys.stdout.write("\n".join(output) + "\n")
if __name__ == '__main__':
    solve()
