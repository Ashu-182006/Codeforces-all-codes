import sys 
def solve():
    n = sys.stdin.read().split()
    if not n:
        return
    t = int(n[0])
    for i in range(1, t + 1):
        if i < len(n):
            s = n[i]
            if '010' in s or '101' in s:
                sys.stdout.write("Good\n")
            else:
                sys.stdout.write("Bad\n")
if __name__ == "__main__":
    solve()
