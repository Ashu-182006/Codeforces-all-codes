import sys

def solve():
    # Read everything at once from standard input
    d = sys.stdin.read().split()
    if not d:
        return
    
    t = int(d[0])
    i = 1
    r = []
    
    for _ in range(t):
        n = int(d[i])
        s = int(d[i+1])
        i += 2  
        
        max_sum = (n * (n + 1)) // 2
        if s > max_sum:
            r.append("-1")
        else:
            result = []
            for j in range(n, 0, -1):
                if s >= j:
                    result.append(str(j))
                    s -= j
                if s == 0:
                    break
            r.append(" ".join(result))
            
    print("\n".join(r))

if __name__ == '__main__':
    solve()
